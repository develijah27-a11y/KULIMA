{
  "buildCommand": "next build && node scripts/build-sw.mjs",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/prices",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/uganda-prices",
      "schedule": "0 3 16 * *"
    },
    {
      "path": "/api/cron/scores",
      "schedule": "0 0 * * 0"
    }
  ]
}
