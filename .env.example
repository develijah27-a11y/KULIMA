# ============================================================================
# KULIMA — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================================

# ── Supabase (client-safe, bundled at build time) ────────────────────────────
# Your project URL — Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key — safe for browser, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (server-only — NEVER expose to client) ──────────────────────────
# Service role key — bypasses RLS, only used in server-side API routes
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App secrets & URLs ────────────────────────────────────────────────────────
# Random 32+ character secret used for session signing
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here

# Public App URL (used for password reset links and email action URLs)
NEXT_PUBLIC_APP_URL=https://www.cropifyapp.com

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Resend API Key from https://resend.com/api-keys (starts with re_...)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address.
# Testing sandbox (sends only to your Resend account email): 'Cropify <onboarding@resend.dev>'
# Production (requires verified domain on Resend): 'Cropify <noreply@yourdomain.com>'
EMAIL_FROM=Cropify <onboarding@resend.dev>

# ── Weather API (optional — falls back to Open-Meteo free tier without it) ───
# OpenWeatherMap API key — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ── Payments (optional) ───────────────────────────────────────────────────────
NYLON_PAY_PUBLIC_KEY=your_nylon_pay_public_key
NYLON_PAY_SECRET_KEY=your_nylon_pay_secret_key
NYLON_PAY_WEBHOOK_SECRET=your_nylon_pay_webhook_secret

# ── SMS (optional) ────────────────────────────────────────────────────────────
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key

# ── AI / Vision (optional) ────────────────────────────────────────────────────
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key

# ── Database (optional — only needed for direct DB access / migrations) ───────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── App config ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
