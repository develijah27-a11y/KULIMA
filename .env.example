# ============================================================================
# Kulima AgriTech Platform - Environment Variables
# ============================================================================
# 
# This file documents all required environment variables for the Kulima platform.
# Copy this file to .env.local and fill in your actual values.
# 
# SECURITY WARNING:
# - NEVER commit .env.local to version control
# - NEVER expose server-only variables (without NEXT_PUBLIC_ prefix) to client
# - Keep your service role key secure - it bypasses Row Level Security
# 
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration (Client-Safe)
# ----------------------------------------------------------------------------
# These variables are prefixed with NEXT_PUBLIC_ and are safe to expose to
# the browser. They are used for client-side Supabase operations.

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase publishable (anon) key
# This key is safe for client-side use and respects Row Level Security
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ----------------------------------------------------------------------------
# Supabase Configuration (Server-Only - NEVER expose to client)
# ----------------------------------------------------------------------------
# These variables are server-only and should NEVER be exposed to the browser.
# They are used for server-side operations that require elevated privileges.

# Your Supabase service role key
# WARNING: This key bypasses Row Level Security - use only in server-side code
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL connection string (optional)
# Used for direct database access when needed
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example: postgresql://postgres:mypassword@db.abcdefghijklmnop.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Application environment
# Options: development, production, test
# Default: development
NODE_ENV=development

# Logging level
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info
